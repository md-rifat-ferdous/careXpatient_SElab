<script>
        // Micro-interactions
        document.querySelectorAll('tbody tr').forEach(row => {
            row.addEventListener('click', (e) => {
                if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'SPAN') {
                    // Logic for selecting a row could go here
                }
            });
        });

        // Simple Tab Logic
        const tabs = document.querySelectorAll('.pb-4.text-sm.font-medium');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active-tab', 'text-primary', 'font-semibold'));
                tabs.forEach(t => t.classList.add('text-on-surface-variant'));
                tab.classList.add('active-tab');
                tab.classList.remove('text-on-surface-variant');
            });
        });
    </script>
