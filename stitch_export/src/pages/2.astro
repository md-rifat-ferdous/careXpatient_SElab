                if (e.target.closest('a')) {
                    document.querySelectorAll('nav a').forEach(item => {
                        item.classList.remove('text-primary', 'font-bold', 'border-r-4', 'border-primary', 'bg-secondary-container/10');
                        item.classList.add('text-on-surface-variant');
                    });
                    const current = e.target.closest('a');
                    current.classList.add('text-primary', 'font-bold', 'border-r-4', 'border-primary', 'bg-secondary-container/10');
                    current.classList.remove('text-on-surface-variant');
                }
            });
        });

        // Search Bar Focus Effect
        const searchInput = document.querySelector('input[type="text"]');
        searchInput.addEventListener('focus', () => {
            searchInput.parentElement.classList.add('scale-[1.02]');
            searchInput.parentElement.style.transition = 'transform 0.2s ease-out';
        });
        searchInput.addEventListener('blur', () => {
            searchInput.parentElement.classList.remove('scale-[1.02]');
        });
    </script>


</body></html>