<style>
        .sidebar {
            transition: width 0.3s ease, transform 0.3s ease;
            width: 16rem; /* 64 * 0.25rem */
        }
        .sidebar.collapsed {
            width: 4.5rem;
        }
        .sidebar.collapsed .sidebar-text {
            display: none;
        }
        .sidebar.collapsed .header-text {
            display: none;
        }
        .sidebar.collapsed .footer-profile {
            display: none;
        }
        .sidebar.collapsed .footer-avatar {
            margin: 0 auto;
        }
        .sidebar.collapsed .footer-profile-container {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }
        @media (max-width: 768px) {
            .sidebar {
                position: absolute;
                transform: translateX(-100%);
            }
            .sidebar.mobile-open {
                transform: translateX(0);
            }
        }
    </style>
