{
  "name": "carexpatient",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=landing-page",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=@carexpatient/backend",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "prisma:generate": "turbo run prisma:generate --filter=@carexpatient/prisma"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
